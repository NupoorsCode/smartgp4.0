+.stat-stop{background:var(--stop-bg);border-color:#E9C4C4}
+.stat-stop b{color:var(--stop)}
+.panel-head{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;margin:34px 0 14px}
+.panel-head h2{margin:0}
+.panel-head .spacer{flex:1}
+.who{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:0 0 24px}
+.who span{font-size:.82rem;color:var(--ink-3)}
+.who button{border:1px solid var(--line);background:#fff;border-radius:999px;padding:8px 15px;font-size:.85rem;font-weight:600;color:var(--ink-2);cursor:pointer;min-height:40px}
+.who button:hover{border-color:var(--teal);color:var(--teal-deep)}
+.who button.on{background:var(--ink);border-color:var(--ink);color:#fff}
+.modal-wide{max-width:660px}
+.modal-head{display:flex;align-items:flex-start;gap:12px;margin-bottom:18px}
+.modal-head h2{font-family:var(--f-body);font-weight:700;font-size:1.2rem;margin:0 0 2px;letter-spacing:0}
+.modal-close{margin-left:auto;border:0;background:transparent;font-size:1.4rem;line-height:1;cursor:pointer;color:var(--ink-3);min-width:44px;min-height:44px;flex:none}
+.modal-close:hover{color:var(--ink)}
+.modal-foot{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:24px;padding-top:18px;border-top:1px solid var(--line-2)}
+.modal-foot .spacer{flex:1}
+.notvisible{font-family:var(--f-mono);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--stop);background:var(--stop-bg);border-radius:999px;padding:3px 9px;margin-left:8px;white-space:nowrap}
+.actioncell{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}
