+/* ---------- Slot picker ----------
+   Three days at a time with arrows either side, per the agreed booking
+   design. The five-column .slots grid above is still used where a whole
+   week is shown at once. */
+.slotpicker{border:1px solid var(--line);border-radius:var(--r-m);background:#fff;padding:14px}
+.slotpage{display:flex;align-items:center;gap:10px}
+.slotpage .slots{flex:1;grid-template-columns:repeat(3,1fr)}
+@media (max-width:560px){.slotpage .slots{grid-template-columns:1fr}}
+.slotarrow{width:44px;min-height:44px;border:1px solid var(--line);background:#fff;border-radius:10px;cursor:pointer;color:var(--ink-2);font-size:1.05rem;flex:none}
+.slotarrow:hover:not([disabled]){border-color:var(--teal);color:var(--teal-deep)}
+.slotarrow[disabled]{opacity:.35;cursor:not-allowed}
+.slot-more{border:1px solid var(--line);background:#fff;border-radius:8px;padding:9px 4px;font-size:.78rem;color:var(--ink-2);cursor:pointer;min-height:40px}
+.slot-more:hover{border-color:var(--teal);color:var(--teal-deep)}
+
+/* ---------- Back-office tiles, headers and dialog ---------- */
+.stat-flag{background:var(--flag-bg);border-color:#EFD5BE}
